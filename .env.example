# Supabase credentials (required for shared database)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Without these, the app falls back to browser-only localStorage.

# Claude AI - Demand Planning (optional)
# Get your API key from: https://console.anthropic.com/
# Required for the AI demand analysis feature in Demand Planning tab.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
