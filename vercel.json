{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/qbo/:action", "destination": "/api/qbo?action=:action" },
    { "source": "/api/shipstation/:action", "destination": "/api/shipstation?action=:action" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/shipstation-pull", "schedule": "0 11 * * *" },
    { "path": "/api/cron/shipstation-pull", "schedule": "0 3 * * *" }
  ]
}
